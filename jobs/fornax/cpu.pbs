#!/bin/bash --login
#PBS -N bench-fornax-cpu
#PBS -q genoa
#PBS -l select=1:ncpus=64:mpiprocs=64
#PBS -l place=excl
#PBS -l walltime=04:00:00
#PBS -j oe
# VASP only (MACE is GPU-only)
# genoa:    qsub -o logs/ -v REP=N,PART=genoa_9354 jobs/fornax/cpu.pbs
# pin a node (use vnode=, NOT host= — CPU hosts are named fornax-cNN-ib0): qsub -l select=1:ncpus=64:mpiprocs=64:vnode=fornax-c13 -v ...,PART=genoa_c13 jobs/fornax/cpu.pbs
# largemem: qsub -q largemem -l select=1:ncpus=128:mpiprocs=128 -o logs/ -v REP=N,PART=largemem jobs/fornax/cpu.pbs
W=${W:-W1}; : "${REP:?-v REP=N}" "${PART:?-v PART=genoa_9354|genoa_7543|largemem}"
REPO=$PBS_O_WORKDIR SITE=fornax
PY=/home/li.mengke/envs/mace-bench/bin/python
source "$REPO/jobs/common.sh"
N=$NCPUS
case "$W" in
  W1) modload vasp/vasp.6.5.1; export OMP_NUM_THREADS=1
      run_w1 "$N" 4 mpiexec -n "$N" vasp_std ;;
  *) echo "CPU jobs run W1 (VASP) only" >&2; exit 2 ;;
esac
