#!/bin/bash --login
#PBS -N bench-fornax-5090
#PBS -q rtx5090
#PBS -l select=1:ncpus=32
#PBS -l place=excl
#PBS -l walltime=03:00:00
#PBS -j oe
# qsub -o logs/ -v W=W1|W2|FP,SIZE=S|L,REP=N[,SMOKE=1] jobs/fornax/gpu.pbs
: "${W:?-v W=W1|W2|FP}" "${REP:=1}"
REPO=$PBS_O_WORKDIR SITE=fornax PART=rtx5090
PY=/home/li.mengke/envs/mace-bench/bin/python
export CUDA_VISIBLE_DEVICES=0
source "$REPO/jobs/common.sh"
case "$W" in
  W1) modload vasp/vasp.6.5.1_nvhpc; export OMP_NUM_THREADS=1
      run_w1 1 1 mpirun -np 1 vasp_std ;;
  W2) run_w2 "${SIZE:?-v SIZE=S|L}" cuda 8 1 ;;
  FP) run_fingerprint fornax_rtx5090 ;;
esac
