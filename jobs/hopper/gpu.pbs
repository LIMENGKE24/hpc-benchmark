#!/bin/bash
#PBS -N bench-hopper
#PBS -P CFP05-CF-241
#PBS -q auto
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb:gpu_model=H200
#PBS -l walltime=03:00:00
#PBS -j oe
# H200: qsub -o logs/ -v SIZE=S|L|FP,REP=N,PART=h200 jobs/hopper/gpu.pbs
# H100: qsub -l select=1:ncpus=8:ngpus=1:mem=32gb:gpu_model=H100 -o logs/ -v SIZE=...,REP=N,PART=h100 jobs/hopper/gpu.pbs
: "${SIZE:?-v SIZE=S|L|FP}" "${REP:=1}" "${PART:?-v PART=h100|h200}"
REPO=$PBS_O_WORKDIR SITE=hopper
PY=/scratch/Projects/CFP-05/CFP05-CF-241/limengke/envs/mace-bench/bin/python
source "$REPO/jobs/common.sh"
gpu=$(nvidia-smi --query-gpu=name --format=csv,noheader | head -1)
case "$PART:$gpu" in h100:*H100*|h200:*H200*) ;; *) echo "wrong GPU for $PART: $gpu" >&2; exit 70;; esac
if [ "$SIZE" = FP ]; then run_fingerprint "hopper_$PART"; else run_w2 "$SIZE" cuda 8 1; fi
