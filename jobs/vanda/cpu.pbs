#!/bin/bash
#PBS -N bench-vanda-cpu
#PBS -P CFP05-CF-241
#PBS -l select=1:ncpus=72:mpiprocs=72:mem=480gb
#PBS -l walltime=04:00:00
#PBS -j oe
# From repo root: qsub -o logs/ -v REP=N[,SMOKE=1] jobs/vanda/cpu.pbs   (VASP only; MACE is GPU-only)
W=${W:-W1}; : "${REP:?-v REP=N}"
REPO=$PBS_O_WORKDIR SITE=vanda PART=batch_cpu
PY=/scratch/projects/CFP05/CFP05-CF-241/limengke/envs/mace-bench/bin/python
source "$REPO/jobs/common.sh"
case "$W" in
  W1) modload openmpi; modload intel/2023b; export OMP_NUM_THREADS=1
      run_w1 72 4 mpiexec -n 72 /home/svu/limengke/bin/vasp.6.5.1/vasp_std ;;
  *) echo "CPU jobs run W1 (VASP) only" >&2; exit 2 ;;
esac
