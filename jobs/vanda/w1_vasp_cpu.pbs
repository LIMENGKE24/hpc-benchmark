#!/bin/bash
#PBS -N bench-W1-cpu
#PBS -P CFP05-CF-241
#PBS -l select=1:ncpus=72:mpiprocs=72:mem=480gb
#PBS -l walltime=04:00:00
#PBS -j oe
# Submit from the repo root:  qsub -v REP=1[,SMOKE=1] jobs/vanda/w1_vasp_cpu.pbs
set -euo pipefail
: "${REP:?Submit with -v REP=N}"
SMOKE=${SMOKE:-0}
REPO=$PBS_O_WORKDIR
PY=/scratch/projects/CFP05/CFP05-CF-241/limengke/envs/mace-bench/bin/python
TAG=vanda/batch_cpu/W1$([ "$SMOKE" = 1 ] && echo -smoke)/rep$REP
RUN=$REPO/runs/$TAG
mkdir -p "$RUN" && cd "$RUN"
cp "$REPO"/inputs/vasp/{INCAR,KPOINTS,POSCAR,POTCAR} .
if [ "$SMOKE" = 1 ]; then sed -i -E 's/^(NELM|NELMIN) += *[0-9]+/\1 = 3/' INCAR; fi

module load openmpi
module load intel/2023b
export OMP_NUM_THREADS=1
VASP=/home/svu/limengke/bin/vasp.6.5.1/vasp_std
{ hostname; lscpu; module list 2>&1; md5sum "$VASP" INCAR KPOINTS POSCAR POTCAR; } > env.log
mpiexec -n 72 "$VASP" > vasp.out
"$PY" "$REPO/analysis/parse_vasp.py" . --tag "$TAG" --units-used 72 --out "$REPO/results/$TAG.json"
