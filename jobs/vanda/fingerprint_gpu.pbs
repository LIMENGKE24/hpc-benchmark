#!/bin/bash
#PBS -N bench-fingerprint
#PBS -P CFP05-CF-241
#PBS -l select=1:ncpus=4:ngpus=1:mem=32gb
#PBS -l walltime=00:20:00
#PBS -j oe
# qsub jobs/vanda/fingerprint_gpu.pbs   -> results/fingerprint/vanda_a40.json
set -euo pipefail
REPO=$PBS_O_WORKDIR
mkdir -p "$REPO/results/fingerprint"
nvidia-smi -L
/scratch/projects/CFP05/CFP05-CF-241/limengke/envs/mace-bench/bin/python "$REPO/inputs/mace/fingerprint.py" \
    "$REPO/inputs/mace/fingerprint.extxyz" "$REPO/models/mace-mpa-0-medium.model" \
    | tee "$REPO/results/fingerprint/vanda_a40.json"
