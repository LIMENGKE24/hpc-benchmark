#!/bin/bash
#PBS -N bench-W2-cpu
#PBS -P CFP05-CF-241
#PBS -l select=1:ncpus=72:mem=200gb
#PBS -l walltime=04:00:00
#PBS -j oe
# qsub -v REP=N[,SMOKE=1] jobs/vanda/w2_mace_cpu.pbs     (CPU runs use size S only)
set -euo pipefail
: "${REP:?Submit with -v REP=N}"
SMOKE=${SMOKE:-0}
REPO=$PBS_O_WORKDIR
PY=/scratch/projects/CFP05/CFP05-CF-241/limengke/envs/mace-bench/bin/python
if [ "$SMOKE" = 1 ]; then WARM=2; STEPS=5; SUF=-smoke; else WARM=20; STEPS=100; SUF=; fi
TAG=vanda/batch_cpu/W2-S$SUF/rep$REP
RUN=$REPO/runs/$TAG
mkdir -p "$RUN" && cd "$RUN"

export OMP_NUM_THREADS=72 MKL_NUM_THREADS=72 PYTHONUNBUFFERED=1 TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1
{ hostname; lscpu; } > env.log
"$PY" -u "$REPO/inputs/mace/bench_md.py" --input "$REPO/inputs/mace/Na3PS4_unit.extxyz" --supercell 4 4 4 \
    --model "$REPO/models/mace-mpa-0-medium.model" --warmup $WARM --steps $STEPS --device cpu --threads 72 \
    --units-used 72 --tag "$TAG" --out "$REPO/results/$TAG.json"
