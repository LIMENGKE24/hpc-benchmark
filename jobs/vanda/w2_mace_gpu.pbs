#!/bin/bash
#PBS -N bench-W2-a40
#PBS -P CFP05-CF-241
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb
#PBS -l walltime=02:00:00
#PBS -j oe
# qsub -v SIZE=S|L,REP=N[,SMOKE=1][,QUEUE_TAG=gpu] jobs/vanda/w2_mace_gpu.pbs   (add -q gpu for the free queue)
set -euo pipefail
: "${SIZE:?Submit with -v SIZE=S|L}" "${REP:?Submit with -v REP=N}"
SMOKE=${SMOKE:-0}
REPO=$PBS_O_WORKDIR
PY=/scratch/projects/CFP05/CFP05-CF-241/limengke/envs/mace-bench/bin/python
case "$SIZE" in S) SC="4 4 4";; L) SC="10 10 10";; *) echo "bad SIZE $SIZE" >&2; exit 2;; esac
if [ "$SMOKE" = 1 ]; then WARM=20; STEPS=50; SUF=-smoke; else WARM=200; STEPS=2000; SUF=; fi
TAG=vanda/${QUEUE_TAG:-batch_gpu}/W2-$SIZE$SUF/rep$REP
RUN=$REPO/runs/$TAG
mkdir -p "$RUN" && cd "$RUN"

export OMP_NUM_THREADS=8 MKL_NUM_THREADS=8 PYTHONUNBUFFERED=1 TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1
{ hostname; nvidia-smi -L; nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv; } > env.log
"$PY" -u "$REPO/inputs/mace/bench_md.py" --input "$REPO/inputs/mace/Na3PS4_unit.extxyz" --supercell $SC \
    --model "$REPO/models/mace-mpa-0-medium.model" --warmup $WARM --steps $STEPS --threads 8 \
    --units-used 1 --tag "$TAG" --out "$REPO/results/$TAG.json"
